{
  "name": "orchestrator-relay",
  "version": "2.0.12",
  "description": "Agent-to-agent coordination relay for autonomous task execution",
  "main": "dist/mcp.js",
  "type": "commonjs",
  "bin": {
    "relay": "./dist/bin/relay"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/cursor && cp -r src/cursor dist/ && mv dist/bin/relay.js dist/bin/relay",
    "dev": "tsx src/mcp.ts",
    "start": "node dist/mcp.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/mcp.js",
    "prepublishOnly": "npm run build",
    "test": "npx tsx --test 'src/**/*.test.ts'"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "relay",
    "agent",
    "coordination",
    "llm",
    "cli"
  ],
  "author": "tsomaia",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "commander": "^14.0.3",
    "fs-extra": "^11.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}